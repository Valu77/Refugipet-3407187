# ============================================================
# RefugiPet — Variables de entorno del backend
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# Agrega ".env" a tu .gitignore si aún no está.
# ============================================================

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@localhost:5433/refugipet-2

# --- JWT ---
SECRET_KEY=cambia_esta_clave_por_una_larga_y_aleatoria_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# SMTP — Configuración de correo electrónico
# ============================================================
# RefugiPet usa estas variables para enviar correos de recuperación
# de contraseña. Si no se configuran, el sistema funciona igual
# pero NO envía correos (devuelve respuesta neutra al usuario).
#
# OPCIÓN A — Gmail con Contraseña de aplicación (desarrollo/pruebas)
# ─────────────────────────────────────────────────────────────────
# 1. Ve a: https://myaccount.google.com/security
# 2. Activa "Verificación en dos pasos" si no está activa
# 3. Ve a: https://myaccount.google.com/apppasswords
# 4. Crea una contraseña de aplicación (elige "Correo" + "Windows")
# 5. Copia los 16 caracteres generados (sin espacios) en SMTP_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
# ↑ Pega aquí los 16 caracteres de tu Contraseña de aplicación de Google
# Los espacios se ignoran automáticamente

SMTP_FROM=RefugiPet <tucorreo@gmail.com>
SMTP_USE_TLS=true
SMTP_SSL=false
# ↑ Deja SSL en false cuando usas STARTTLS (puerto 587)

# URL del frontend (para los enlaces en los correos)
FRONTEND_URL=http://localhost:5173


# ============================================================
# OPCIÓN B — Brevo (antiguo Sendinblue) para producción
# ============================================================
# Brevo ofrece 300 correos/día gratis, mejor entregabilidad
# y no requiere configuraciones especiales de Google.
# Regístrate en: https://www.brevo.com/es/
# Ve a SMTP & API → Genera credenciales SMTP
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@tudominio.com
# SMTP_PASSWORD=tu_api_key_brevo
# SMTP_FROM=RefugiPet <tucorreo@tudominio.com>
# SMTP_USE_TLS=true
# SMTP_SSL=false
# FRONTEND_URL=https://tudominio.com


# ============================================================
# OPCIÓN C — Outlook / Hotmail
# ============================================================
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@outlook.com
# SMTP_PASSWORD=tu_contraseña_outlook
# SMTP_FROM=RefugiPet <tucorreo@outlook.com>
# SMTP_USE_TLS=true
# SMTP_SSL=false
# FRONTEND_URL=http://localhost:5173


# ============================================================
# NOTA DE SEGURIDAD
# ============================================================
# - Nunca pongas estas claves directamente en el código fuente.
# - Nunca subas este archivo .env al repositorio (solo .env.example).
# - En producción usa variables de entorno del servidor o un vault.
# - Las Contraseñas de aplicación de Google son distintas a tu
#   contraseña de Gmail — se pueden revocar sin cambiar tu cuenta.
